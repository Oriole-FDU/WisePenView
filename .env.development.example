# 开发环境（vite dev）
# 后端服务器地址 host[:port]，协议在运行时按 window.location.protocol 推导
VITE_API_SERVER_ADDR=/api
VITE_DEV_API_PROXY_TARGET=http://test.api.fudan.wisepen.oriole.cn
# Optional direct WebSocket target. Local gray dev should use the local Sidecar;
# the developer tag is sent as a query param because browsers cannot set WS headers.
# VITE_NOTE_COLLAB_WS_ADDR=http://127.0.0.1:9700
# Optional Vite WS proxy target for note-collab only. Keep generic /api proxy HTTP-only.
# VITE_DEV_NOTE_COLLAB_PROXY_TARGET=http://127.0.0.1:9700

# Service 注册表（相对项目根目录）；dev 使用真实实现
SERVICES_REGISTRY=./src/domains/_registry/registry.impl.ts

# 流量定向
VITE_X_DEVELOPER=

# DrawIO 静态编辑器入口；本地运行 WisePenDrawIO 的 pnpm dev 后可启用
# VITE_DRAWIO_EMBED_URL=http://localhost:5174/drawio/index.html
